# setup.sh generates the local secrets automatically.
POSTGRES_PASSWORD=
WEBUI_SECRET_KEY=
MEMORY_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.org

# External OpenAI-compatible API; choose an available provider model.
CLOUD_MODEL=openai/YOUR_MODEL_NAME
CLOUD_API_BASE=https://api.openai.com/v1
CLOUD_API_KEY=

# true: include relevant memories in external LLM requests.
# false: keep local management available but disable automatic memory inclusion.
SEND_MEMORIES_TO_CLOUD=true

# Use an SSH tunnel or a local HTTPS reverse proxy.
BIND_ADDRESS=127.0.0.1

# Moving starter tags; pin tested releases or digests for ongoing operation.
OPENWEBUI_TAG=main
LITELLM_TAG=main-stable
QDRANT_TAG=latest

# Optional single-domain HTTPS reverse proxy.
# Set a hostname only, without https://, a port, or a path.
PUBLIC_DOMAIN=ai.sfs.at
ACME_EMAIL=admin@example.org
CADDY_TAG=2-alpine
# Uncomment to enable HTTPS for all ordinary docker compose commands:
# COMPOSE_FILE=compose.yaml:compose.proxy.yaml

# Optional existing Let's Encrypt certificate directory name for Apache.
# Leave empty to use PUBLIC_DOMAIN. The certificate must cover PUBLIC_DOMAIN.
APACHE_CERTIFICATE_NAME=
